# Module 2: Social Media Monitoring & Impersonation Detection
# Backend Environment Configuration

# Database
DATABASE_URL=sqlite:///./monitoring.db
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Authentication
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Module 1 Integration (Brand Intelligence & Official Asset Registry)
MODULE1_API_BASE_URL=http://localhost:8000
MODULE1_API_KEY=

# Social Media API Keys (optional - for live API access)
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_BEARER_TOKEN=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_ACCESS_TOKEN=

FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_ACCESS_TOKEN=

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=

YOUTUBE_API_KEY=

# AI/LLM for enhanced detection
GEMINI_API_KEY=

# Redis for caching and task queue
REDIS_URL=redis://localhost:6379/0

# Monitoring Settings
SCAN_INTERVAL_MINUTES=60
SIMILARITY_THRESHOLD=0.85
MAX_CONCURRENT_SCANS=5
DEFAULT_USER_ID=default_brand_owner_01

# Demo Mode
DEMO_MODE=true